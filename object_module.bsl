Перем КаталогВход;
Перем КаталогProcessed;
Перем КаталогNew;
Перем КаталогMappings;

////////////////////////////////////////////////////////////////////////////////
// ТОЧКА ВХОДА
////////////////////////////////////////////////////////////////////////////////

Процедура ВыполнитьЗагрузку() Экспорт

	ИнициализироватьПути();
	ПодготовитьКаталоги();

	Лог("INFO | Старт загрузки JSON");

	Файлы = ПолучитьJSONФайлыИзКаталога(КаталогВход);

	Если Файлы.Количество() = 0 Тогда
		Лог("INFO | В папке inbox JSON-файлы не найдены");
		Возврат;
	КонецЕсли;

	Маппинг = ЗагрузитьМаппингНоменклатуры();

	Для Каждого ПутьJSON Из Файлы Цикл
		Попытка
			ОбработатьОдинФайлJSON(ПутьJSON, Маппинг);
		Исключение
			Лог("ERROR | Ошибка обработки файла: " + ПутьJSON + " | " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Лог("INFO | Завершено");

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОСНОВНАЯ ОБРАБОТКА ФАЙЛА
////////////////////////////////////////////////////////////////////////////////

Процедура ОбработатьОдинФайлJSON(ПутьJSON, Маппинг)

	Лог("INFO | Обрабатываю файл: " + ПутьJSON);

	Корень = ПрочитатьJSONИзФайла(ПутьJSON);

	Если Корень = Неопределено Тогда
		Лог("ERROR | Не удалось прочитать JSON: " + ПутьJSON);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Корень) = Тип("Массив") Тогда
		Если Корень.Количество() = 0 Тогда
			Лог("WARN | Пустой массив в JSON: " + ПутьJSON);
			ПереместитьВProcessed(ПутьJSON);
			Возврат;
		КонецЕсли;

		ОбъектТТН = Корень[0];

	ИначеЕсли ТипЗнч(Корень) = Тип("Структура") Тогда
		ОбъектТТН = Корень;

	Иначе
		Лог("ERROR | Неожиданный тип корня JSON: " + ТипЗнч(Корень));
		Возврат;
	КонецЕсли;

	СоздатьДокументПоступленияИзТТН(ОбъектТТН, Маппинг, ПутьJSON);

	ПереместитьВProcessed(ПутьJSON);

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СОЗДАНИЕ ДОКУМЕНТА 1С
////////////////////////////////////////////////////////////////////////////////

Процедура СоздатьДокументПоступленияИзТТН(ТТН, Маппинг, ПутьJSON)

	Док = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();

	НомерТТН = ПолучитьСтрокуИзJSON(ТТН, "номер_ТТН");
	СерияТТН = ПолучитьСтрокуИзJSON(ТТН, "серия_ТТН");
	ДатаТТНСтрокой = ПолучитьСтрокуИзJSON(ТТН, "дата_ТТН");

	Комментарий = "TTN JSON";
	Если НЕ ПустаяСтрока(СерияТТН) Или НЕ ПустаяСтрока(НомерТТН) Тогда
		Комментарий = Комментарий + " | " + СерияТТН + " " + НомерТТН;
	КонецЕсли;
	Если НЕ ПустаяСтрока(ДатаТТНСтрокой) Тогда
		Комментарий = Комментарий + " | " + ДатаТТНСтрокой;
	КонецЕсли;

	Попытка
		Док.Комментарий = Лев(Комментарий, 250);
	Исключение
	КонецПопытки;

	ДатаДок = ПреобразоватьСтрокуВДату(ДатаТТНСтрокой);
	Если ДатаДок <> Неопределено Тогда
		Попытка
			Док.Дата = ДатаДок;
		Исключение
		КонецПопытки;
	КонецЕсли;

	УНПКонтрагент = ПолучитьСтрокуИзJSON(ТТН, "УНП_грузополучателя");
	Если ПустаяСтрока(УНПКонтрагент) Тогда
		УНПКонтрагент = ПолучитьСтрокуИзJSON(ТТН, "УНП_заказчика_автоперевозки");
	КонецЕсли;

	Если НЕ ПустаяСтрока(УНПКонтрагент) Тогда
		ПопыткаЗаполнитьКонтрагентаПоУНП(Док, УНПКонтрагент);
	КонецЕсли;

	Товары = ПолучитьМассивИзJSON(ТТН, "товары");
	Если Товары = Неопределено Тогда
		Лог("WARN | В JSON нет массива 'товары'");
	Иначе

		Для Каждого СтрТовар Из Товары Цикл

			НоваяСтрока = Док.Товары.Добавить();

			Наим = ПолучитьСтрокуИзJSON(СтрТовар, "наименование_товара");
			Кол = ПолучитьЧислоИзJSON(СтрТовар, "количество");
			Цена = ПолучитьЧислоИзJSON(СтрТовар, "цена");
			Сумма = ПолучитьЧислоИзJSON(СтрТовар, "стоимость");

			ПопыткаЗаполнитьНоменклатуру(НоваяСтрока, Наим, Маппинг);

			Если Кол <> Неопределено Тогда
				Попытка
					НоваяСтрока.Количество = Кол;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Если Цена <> Неопределено Тогда
				Попытка
					НоваяСтрока.Цена = Цена;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Если Сумма <> Неопределено Тогда
				Попытка
					НоваяСтрока.Сумма = Сумма;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Если ПустаяСсылка(НоваяСтрока.Номенклатура) Тогда
				Попытка
					НоваяСтрока.Содержание = Лев(Наим, 250);
				Исключение
				КонецПопытки;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Док.Записать();

	Лог("OK | Создан документ Поступление: " + Док.Ссылка);
	ЛогВФайл("OK | Создан документ: " + Строка(Док.Ссылка) + " | Файл: " + ПутьJSON);

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// МАППИНГ НОМЕНКЛАТУРЫ
////////////////////////////////////////////////////////////////////////////////

Функция ЗагрузитьМаппингНоменклатуры() Экспорт

	ПутьМаппинга = КаталогMappings + "\product_mapping.json";

	Если НЕ ФайлСуществует(ПутьМаппинга) Тогда
		Лог("INFO | product_mapping.json не найден, работаем без маппинга");
		Возврат Новый Соответствие;
	КонецЕсли;

	Данные = ПрочитатьJSONИзФайла(ПутьМаппинга);

	Если Данные = Неопределено Тогда
		Лог("WARN | Не удалось прочитать product_mapping.json, работаем без маппинга");
		Возврат Новый Соответствие;
	КонецЕсли;

	Рез = Новый Соответствие;

	Если ТипЗнч(Данные) = Тип("Структура") Тогда

		Для Каждого К Из Данные Цикл
			Рез.Вставить(НРег(СокрЛП(К.Ключ)), СокрЛП(Строка(К.Значение)));
		КонецЦикла;

		Лог("INFO | Маппинг загружен (структура), ключей: " + Формат(Рез.Количество(), "ЧГ=0"));
		Возврат Рез;

	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Массив") Тогда

		Для Каждого Э Из Данные Цикл
			Если ТипЗнч(Э) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;

			Ключ = "";
			Значение = "";

			Если Э.Свойство("json_name") Тогда
				Ключ = СокрЛП(Строка(Э.json_name));
			ИначеЕсли Э.Свойство("key") Тогда
				Ключ = СокрЛП(Строка(Э.key));
			КонецЕсли;

			Если Э.Свойство("nomenclature") Тогда
				Значение = СокрЛП(Строка(Э.nomenclature));
			ИначеЕсли Э.Свойство("value") Тогда
				Значение = СокрЛП(Строка(Э.value));
			КонецЕсли;

			Если НЕ ПустаяСтрока(Ключ) И НЕ ПустаяСтрока(Значение) Тогда
				Рез.Вставить(НРег(Ключ), Значение);
			КонецЕсли;

		КонецЦикла;

		Лог("INFO | Маппинг загружен (массив), ключей: " + Формат(Рез.Количество(), "ЧГ=0"));
		Возврат Рез;

	КонецЕсли;

	Лог("WARN | product_mapping.json имеет неподдерживаемый формат");
	Возврат Новый Соответствие;

КонецФункции


Процедура ПопыткаЗаполнитьНоменклатуру(СтрокаТовара, НаименованиеИзJSON, Маппинг)

	Если ПустаяСтрока(НаименованиеИзJSON) Тогда
		Возврат;
	КонецЕсли;

	ИмяДляПоиска = НаименованиеИзJSON;

	Если Маппинг <> Неопределено Тогда
		Ключ = НРег(СокрЛП(НаименованиеИзJSON));
		Если Маппинг.СодержитКлюч(Ключ) Тогда
			ИмяДляПоиска = СокрЛП(Строка(Маппинг.Получить(Ключ)));
		КонецЕсли;
	КонецЕсли;

	Ном = Справочники.Номенклатура.НайтиПоНаименованию(ИмяДляПоиска);

	Если НЕ ПустаяСсылка(Ном) Тогда
		Попытка
			СтрокаТовара.Номенклатура = Ном;
		Исключение
		КонецПопытки;
	Иначе
		Лог("WARN | Номенклатура не найдена: " + ИмяДляПоиска);
	КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// КОНТРАГЕНТ ПО УНП
////////////////////////////////////////////////////////////////////////////////

Процедура ПопыткаЗаполнитьКонтрагентаПоУНП(Док, УНП)

	Если ПустаяСтрока(УНП) Тогда
		Возврат;
	КонецЕсли;

	Контрагент = Справочники.Контрагенты.НайтиПоКоду(УНП);

	Если ПустаяСсылка(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Док.Контрагент = Контрагент;
	Исключение
	КонецПопытки;

	Попытка
		ВыборкаДоговоров = Справочники.ДоговорыКонтрагентов.Выбрать();
		Пока ВыборкаДоговоров.Следующий() Цикл
			Если ВыборкаДоговоров.Владелец = Контрагент Тогда
				Док.ДоговорКонтрагента = ВыборкаДоговоров.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// JSON HELPERS
////////////////////////////////////////////////////////////////////////////////

Функция ПрочитатьJSONИзФайла(ПутьФайла)

	Если НЕ ФайлСуществует(ПутьФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТД = Новый ТекстовыйДокумент;

	Попытка
		ТД.Прочитать(ПутьФайла, КодировкаТекста.UTF8);
	Исключение
		Попытка
			ТД.Прочитать(ПутьФайла);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;

	ТекстJSON = ТД.ПолучитьТекст();

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);

	Попытка
		Возврат ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Лог("ERROR | Ошибка парсинга JSON: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции


Функция ПолучитьСтрокуИзJSON(Obj, ИмяКлюча)

	Значение = ПолучитьЗначениеИзСтруктуры(Obj, ИмяКлюча);

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Если ТипЗнч(Значение) = Тип("Null") Тогда
			Возврат "";
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат СокрЛП(Строка(Значение));

КонецФункции


Функция ПолучитьЧислоИзJSON(Obj, ИмяКлюча)

	Значение = ПолучитьЗначениеИзСтруктуры(Obj, ИмяКлюча);

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если ТипЗнч(Значение) = Тип("Null") Тогда
			Возврат Неопределено;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Возврат Число(Значение);
	Исключение
		Попытка
			Возврат Число(СтрЗаменить(Строка(Значение), ".", ","));
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;

КонецФункции


Функция ПолучитьМассивИзJSON(Obj, ИмяКлюча)

	Значение = ПолучитьЗначениеИзСтруктуры(Obj, ИмяКлюча);

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


Функция ПолучитьЗначениеИзСтруктуры(Obj, ИмяКлюча)

	Если Obj = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Obj) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Obj.Свойство(ИмяКлюча) Тогда
		Возврат Obj[ИмяКлюча];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ФАЙЛЫ / КАТАЛОГИ
////////////////////////////////////////////////////////////////////////////////

Процедура ИнициализироватьПути()

	БазаПуть = "C:\1C_BOT\TTN_INBOX";

	КаталогВход = БазаПуть;
	КаталогProcessed = БазаПуть + "\processed";
	КаталогNew = БазаПуть + "\new";
	КаталогMappings = БазаПуть + "\mappings";

КонецПроцедуры


Процедура ПодготовитьКаталоги()

	СоздатьКаталогЕслиНет(КаталогВход);
	СоздатьКаталогЕслиНет(КаталогProcessed);
	СоздатьКаталогЕслиНет(КаталогNew);
	СоздатьКаталогЕслиНет(КаталогMappings);

КонецПроцедуры


Процедура СоздатьКаталогЕслиНет(ПутьКаталога)

	Если ПустаяСтрока(ПутьКаталога) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ФайлСуществует(ПутьКаталога) Тогда
		Попытка
			СоздатьКаталог(ПутьКаталога);
		Исключение
			Лог("WARN | Не удалось создать каталог: " + ПутьКаталога + " | " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры


Функция ПолучитьJSONФайлыИзКаталога(ПутьКаталога)

	Рез = Новый Массив;

	Попытка
		Файлы = НайтиФайлы(ПутьКаталога, "*.json", Ложь);
	Исключение
		Лог("ERROR | Не удалось получить список файлов: " + ПутьКаталога);
		Возврат Рез;
	КонецПопытки;

	Для Каждого Ф Из Файлы Цикл
		Рез.Добавить(Ф.ПолноеИмя);
	КонецЦикла;

	Возврат Рез;

КонецФункции


Процедура ПереместитьВProcessed(ПутьJSON)

	ИмяФайла = ПолучитьИмяФайлаИзПути(ПутьJSON);
	ПутьНазначения = КаталогProcessed + "\" + ИмяФайла;

	Если ФайлСуществует(ПутьНазначения) Тогда
		ПутьНазначения = КаталогProcessed + "\" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + "_" + ИмяФайла;
	КонецЕсли;

	Попытка
		ПереместитьФайл(ПутьJSON, ПутьНазначения);
		Лог("INFO | Файл перемещен в processed: " + ПутьНазначения);
	Исключение
		Лог("WARN | Не удалось переместить файл в processed: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры


Функция ПолучитьИмяФайлаИзПути(ПутьФайла)

	П = СтрЗаменить(ПутьФайла, "/", "\");
	Позиция = 0;
	Счетчик = СтрДлина(П);

	Пока Счетчик > 0 Цикл
		Если Сред(П, Счетчик, 1) = "\" Тогда
			Позиция = Счетчик;
			Прервать;
		КонецЕсли;
		Счетчик = Счетчик - 1;
	КонецЦикла;

	Если Позиция = 0 Тогда
		Возврат П;
	КонецЕсли;

	Возврат Сред(П, Позиция + 1);

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ЛОГИ
////////////////////////////////////////////////////////////////////////////////

Процедура Лог(ТекстСообщения) Экспорт
	Сообщить(ТекстСообщения);
	ЛогВФайл(ТекстСообщения);
КонецПроцедуры


Процедура ЛогВФайл(ТекстСообщения) Экспорт

	ПутьЛога = КаталогNew + "\json_receiver_last_result.txt";

	ТД = Новый ТекстовыйДокумент;
	СтрокаЛога = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss") + " | " + ТекстСообщения;

	Если ФайлСуществует(ПутьЛога) Тогда
		Попытка
			ТД.Прочитать(ПутьЛога, КодировкаТекста.UTF8);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если ТД.КоличествоСтрок() > 0 Тогда
		ТД.ДобавитьСтроку("");
	КонецЕсли;

	ТД.ДобавитьСтроку(СтрокаЛога);

	Попытка
		ТД.Записать(ПутьЛога, КодировкаТекста.UTF8);
	Исключение
	КонецПопытки;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЧЕЕ
////////////////////////////////////////////////////////////////////////////////

Функция ПреобразоватьСтрокуВДату(СтрокаДата)

	Если ПустаяСтрока(СтрокаДата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если СтрДлина(СтрокаДата) >= 10 И Сред(СтрокаДата, 5, 1) = "-" Тогда
			Г = Сред(СтрокаДата, 1, 4);
			М = Сред(СтрокаДата, 6, 2);
			Д = Сред(СтрокаДата, 9, 2);
			Возврат Дата(Число(Г), Число(М), Число(Д));
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Возврат Дата(СтрокаДата);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции
